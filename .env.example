# Project_A1 Environment Configuration Template
# Copy this file to .env on the target machine and adjust values as needed.
# DO NOT commit real secrets or encryption keys to version control.

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Physical Serial Hardware Link
# Set to AUTO to automatically discover CH340 / CP2102 USB-UART, or specify COM port (e.g., COM3, COM4, COM5)
SERIAL_PORT=AUTO
SERIAL_BAUD_RATE=115200

# Storage & Database
DATABASE_PATH=backend/industrial_scada.db

# Security & Secret Storage
# Note: In production, store sensitive API tokens in Windows Credential Manager or DPAPI.
SECRET_KEY=change-me-to-a-secure-random-token
